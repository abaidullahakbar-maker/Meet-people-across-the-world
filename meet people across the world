local function markDirty()

	if rebuildPending then
		return
	end

	rebuildPending=true

	task.delay(
		.05,
		function()

			rebuildPending=false

			if alive
			and rebuild then

				pcall(rebuild)
			end

			if updateMini then
				updateMini()
			end
		end
	)
end

local function scanRooms()

	table.clear(rooms)

	local RS=
		W:FindFirstChild(
			"RoomSpawner"
		)

	if not RS then

		markDirty()
		return
	end

	for _,node in ipairs(
		RS:GetChildren()
	) do

		local sign=nil

		for _,x in ipairs(
			node:GetDescendants()
		) do

			if x:IsA(
				"TextLabel"
			) then

				local value=low(x.Text)

				if value:find(
					"'s room",
					1,
					true
				)
				or
				value:find(
					"’s room",
					1,
					true
				) then

					sign=x
					break
				end
			end
		end

		if sign then

			table.insert(
				rooms,
				{
					user=node.Name,
					name=display(node.Name),
					node=node,
					sign=sign
				}
			)
		end
	end

	markDirty()
end

local function rebuildGroups()

	table.clear(groups)

	for _,p in ipairs(
		P:GetPlayers()
	) do

		local room=
			p:GetAttribute(
				"RoomTP"
			)

		if room
		and tostring(room)~="" then

			room=tostring(room)

			groups[room]=
				groups[room]
				or {}

			table.insert(
				groups[room],
				p
			)
		end
	end

	for _,list in pairs(groups) do

		table.sort(
			list,
			function(a,b)

				return
					low(a.DisplayName)
					<
					low(b.DisplayName)
			end
		)
	end
end

local function roomChanged(p)

	local new=
		p:GetAttribute(
			"RoomTP"
		)

	new=
		new
		and tostring(new)
		or nil

	local old=lastRoom[p]

	if old~=new then

		if old then

			addHistory(
				p.DisplayName..
					" left "..
					display(old)
			)
		end

		if new then

			addHistory(
				p.DisplayName..
					" joined "..
					display(new)
			)
		end

		lastRoom[p]=new
	end

	rebuildGroups()
	markDirty()
end

