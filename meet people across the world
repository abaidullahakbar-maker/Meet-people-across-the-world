--==============================================================
-- REBUILD
--==============================================================

rebuild=function()

	clearRows()

	table.clear(
		specHistoryLabels
	)

	------------------------------------------------------------
	-- LIVE SPECTATORS
	------------------------------------------------------------

	local specs={}

	for w,d in pairs(rel) do

		table.insert(
			specs,
			{
				w=w,
				t=d.target
			}
		)
	end

	table.sort(
		specs,
		function(a,b)

			return
				low(a.w.DisplayName)
				<
				low(b.w.DisplayName)
		end
	)

	section(
		"SPECTATORS",
		#specs
	)

	if #specs==0 then

		simpleRow(
			"No active spectators"
		)

	else

		for _,v in ipairs(specs) do

			spectatorRow(
				v.w,
				v.t
			)
		end
	end

	------------------------------------------------------------
	-- SPEC HISTORY
	------------------------------------------------------------

	if specHistoryEnabled then

		section(
			"SPEC HISTORY",
			#specHistory
		)

		if #specHistory==0 then

			simpleRow(
				"No spectator activity"
			)

		else

			for i=1,
				math.min(
					#specHistory,
					8
				) do

				specHistoryRow(
					specHistory[i]
				)
			end
		end
	end

	------------------------------------------------------------
	-- ROOMS
	------------------------------------------------------------

	local list={}

	for _,room in ipairs(rooms) do

		local players=
			groups[
				room.user
			]
			or {}

		if showEmpty
		or #players>0 then

			table.insert(
				list,
				{
					room=room,
					players=players
				}
			)
		end
	end

	table.sort(
		list,
		function(a,b)

			local ao=
				#a.players>0
				and 1
				or 0

			local bo=
				#b.players>0
				and 1
				or 0

			if ao~=bo then
				return ao>bo
			end

			local af=
				favorites[
					a.room.user
				]
				and 1
				or 0

			local bf=
				favorites[
					b.room.user
				]
				and 1
				or 0

			if af~=bf then
				return af>bf
			end

			return
				low(
					a.room.name
				)
				<
				low(
					b.room.name
				)
		end
	)

	section(
		"ROOMS",
		#list
	)

	if #list==0 then

		simpleRow(
			"No rooms detected"
		)

	else

		for _,v in ipairs(list) do

			roomRow(
				v.room,
				v.players
			)
		end
	end

	------------------------------------------------------------
	-- ROOM HISTORY
	------------------------------------------------------------

	if historyEnabled then

		section(
			"ROOM HISTORY",
			#history
		)

		if #history==0 then

			simpleRow(
				"No room activity"
			)

		else

			for i=1,
				math.min(
					#history,
					8
				) do

				simpleRow(
					history[i],
					T.SUB
				)
			end
		end
	end

	updateOH()
	updateDoorESP()
	updateMini()
end

