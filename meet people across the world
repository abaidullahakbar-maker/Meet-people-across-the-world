			or
			c:FindFirstChild("HumanoidRootPart")
		)

	if not head then
		return
	end

	if OH[p]
	and
	OH[p].Parent==head then

		return OH[p]
	end

	delOH(p)

	local g=Instance.new("BillboardGui",head)

	g.Size=UDim2.fromOffset(230,42)

	g.StudsOffset=
