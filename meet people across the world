local function round(x,r)
	local c=Instance.new("UICorner",x)
	c.CornerRadius=UDim.new(0,r or 6)
end

local function stroke(x,col,tr)
	local s=Instance.new("UIStroke",x)
	s.Color=col or T.BORDER
	s.Transparency=tr or .3
end

local function lbl(p,v,size,col,bold)

	local x=Instance.new("TextLabel",p)

	x.BackgroundTransparency=1
	x.Text=v or ""
	x.TextColor3=col or T.TEXT
	x.TextSize=size or 9

	x.Font=
		bold
		and Enum.Font.GothamBold
		or Enum.Font.GothamMedium

	x.TextXAlignment=Enum.TextXAlignment.Left
	x.TextYAlignment=Enum.TextYAlignment.Center

	return x
end

local function low(x)
	return string.lower(tostring(x or ""))
end

local function clean(x)

	return tostring(x or "")
		:gsub("<.->","")
		:gsub("^%s+","")
		:gsub("%s+$","")
end

