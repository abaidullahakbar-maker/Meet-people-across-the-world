local function refreshGameSpectateTP(forceSearch)
	if not spectateTpEnabled then
		clearGameSpectateCache()
		return
	end

	-- Avoid expensive fallback searches more than twice per second.
	if forceSearch and os.clock()-lastSpectateSearch<.5 then
		return
	end

	if forceSearch then
		lastSpectateSearch=os.clock()
	end

	local source,root=findGameSpectateTeleport()

	if not source or not root then
		removeGameSpectateTP()
		return
	end

	if gameSpectateTP
	and gameSpectateTP.Parent then
		gameSpectateTP.Visible=source.Visible
		return
	end

	local b=Instance.new("TextButton")
	b.Name="NUKE_SpectateTP"
	b.Text="NUKE TP\nFREE"
	b.Parent=source.Parent

	copyButtonLook(source,b)

	b.Position=
		source.Position+
		UDim2.fromOffset(
			0,
			math.max(source.AbsoluteSize.Y,24)+6
		)

	gameSpectateTP=b

	connect(
		b.MouseButton1Click,
		function()
			local p=selectedSpectatePlayer(gameSpectateRoot)

			if not p then
				b.Text="NO TARGET"
			else
				b.Text=teleportToPlayer(p) and "TELEPORTED" or "TP FAILED"
			end

			task.delay(.65,function()
				if alive and b.Parent then
					b.Text="NUKE TP\nFREE"
				end
			end)
		end
	)
end

local function queueSpectateSearch()
	if spectateSearchQueued
	or not spectateTpEnabled then
		return
	end

	spectateSearchQueued=true

	task.delay(.18,function()
		spectateSearchQueued=false

		if alive and spectateTpEnabled then
			pcall(refreshGameSpectateTP,true)
		end
	end)
end

-- Important performance change:
-- Do NOT rescan PlayerGui for every TextLabel/TextButton created.
-- We only react when a likely Teleport/Spectate control appears.
connect(
	PG.DescendantAdded,
	function(x)
		if not spectateTpEnabled then
			return
		end

		if x:IsA("TextButton") then
			-- Text can be assigned just after creation, so check now and once deferred.
			if candidateTeleportButton(x) then
				if setSpectateSource(x) then
					pcall(refreshGameSpectateTP,false)
				end
			else
				task.defer(function()
					if alive
					and spectateTpEnabled
					and candidateTeleportButton(x) then
						if setSpectateSource(x) then
							pcall(refreshGameSpectateTP,false)
						end
					end
				end)
			end
		end
	end
)

connect(
