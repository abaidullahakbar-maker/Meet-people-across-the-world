local function createInvisibleESP(p)

	if not seeInvisible
	or not p
	or p==L then
		return
	end

	if not isActuallyInvisible(p) then

		removeInvisibleESP(p)
		return
	end

	local c=p.Character

	if not c
	or not c.Parent then

		removeInvisibleESP(p)
		return
	end

	local current=invisibleESP[p]

	if current
	and current.character~=c then

		removeInvisibleESP(p)
		current=nil
	end

	if not current then

		local folder=
			Instance.new(
				"Folder"
			)

		folder.Name=
			"NUKE_INVISIBLE_"..
			p.Name

		folder.Parent=G

		current={
			character=c,
			folder=folder,
			parts={}
		}

		invisibleESP[p]=current

		addInvisibleName(
			p,
			c,
			folder
		)
	end

	for _,part in ipairs(
		c:GetDescendants()
	) do

		if part:IsA("BasePart")
		and BODY_NAMES[part.Name] then

			if not current.parts[part]
			or
			not current.parts[part].Parent then

				local box=
					addBodyAdornment(
						part,
						current.folder
					)

				if box then

					current.parts[part]=box
				end
			else

				-- Keep box matching avatar scale.
				current.parts[part].Size=
					part.Size+
					Vector3.new(
						.08,
						.08,
						.08
					)
			end
		end
	end

	local dead={}

	for part,box in pairs(
		current.parts
	) do

		if not part.Parent
		or
		not part:IsDescendantOf(c) then

			table.insert(
				dead,
				part
			)

			if box then

				pcall(function()
					box:Destroy()
				end)
			end
		end
	end

	for _,part in ipairs(dead) do
		current.parts[part]=nil
	end
end

updateInvisibleESP=function()

	if not seeInvisible then

		clearInvisibleESP()
		return
	end

	local active={}

	for _,p in ipairs(
		P:GetPlayers()
	) do

		if p~=L
		and isActuallyInvisible(p) then

			active[p]=true

			createInvisibleESP(p)
		end
	end

	local remove={}

	for p in pairs(
		invisibleESP
	) do

		if not active[p]
		or
		not p.Parent
		or
		not p.Character then

			table.insert(
				remove,
				p
			)
		end
	end

	for _,p in ipairs(remove) do
		removeInvisibleESP(p)
	end
end

