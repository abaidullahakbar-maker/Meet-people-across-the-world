--==============================================================

local function doorPart(room)

	local x=room.sign

	while x
	and x~=room.node do

		if x:IsA("BasePart") then
			return x
		end

		x=x.Parent
	end

	for _,v in ipairs(
		room.node:GetDescendants()
	) do

		if v:IsA("BasePart") then
			return v
		end
	end
end

local function clearDoorESP()

	for _,g in pairs(
		doorObjects
	) do

		if g then
			g:Destroy()
		end
	end

	table.clear(doorObjects)
end

local function updateDoorESP()

	if not doorESP then

		clearDoorESP()
		return
	end

	local valid={}

	for _,room in ipairs(rooms) do

		valid[room.node]=true

		local g=
			doorObjects[
				room.node
			]

		if not g then

			local part=
				doorPart(room)

			if part then

				g=
					Instance.new(
						"BillboardGui",
						part
					)

				g.Size=
					UDim2.fromOffset(
						200,
						28
					)

				g.StudsOffset=
					Vector3.new(
						0,
						3.1,
						0
					)

				g.AlwaysOnTop=true
				g.MaxDistance=0

				local l=
					lbl(
						g,
						"",
						10,
						T.TEXT,
						true
					)

				l.Name="Label"

				l.Size=
					UDim2.new(
						1,
						0,
						1,
						0
					)

				l.TextStrokeTransparency=.15
				l.TextStrokeColor3=Color3.new()

				doorObjects[
					room.node
				]=g
			end
		end

		if g
		and
		g:FindFirstChild(
			"Label"
		) then

			local count=
				#(
					groups[
						room.user
					]
					or {}
				)

			g.Label.Text=
				"⌂ "..
				room.name..
				"  ["..
				tostring(count)..
				"]"

			g.Label.TextColor3=
				count>0
				and T.GREEN
				or T.TEXT
		end
	end

	for node,g in pairs(
		doorObjects
	) do

		if not valid[node] then

			g:Destroy()

			doorObjects[node]=nil
		end
	end
end

