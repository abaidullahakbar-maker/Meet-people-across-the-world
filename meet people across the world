local miniDragging=false
local miniMoved=false

local miniStart
local miniPos

connect(
	MiniClick.InputBegan,
	function(i)

		if i.UserInputType==
			Enum.UserInputType.MouseButton1 then

			miniDragging=true
			miniMoved=false

			miniStart=i.Position
			miniPos=Mini.Position
		end
	end
)

connect(
	U.InputChanged,
	function(i)

		if miniDragging
		and
		i.UserInputType==
			Enum.UserInputType.MouseMovement then

			local d=
				i.Position-miniStart

			if math.abs(d.X)>4
			or math.abs(d.Y)>4 then

				miniMoved=true
			end

			Mini.Position=
				UDim2.new(
					miniPos.X.Scale,
					miniPos.X.Offset+d.X,

					miniPos.Y.Scale,
					miniPos.Y.Offset+d.Y
				)
		end
	end
)

connect(
	U.InputEnded,
	function(i)

		if i.UserInputType==
			Enum.UserInputType.MouseButton1
		and miniDragging then

			miniDragging=false

			if not miniMoved then
				setMini(false)
			end
		end
	end
)

