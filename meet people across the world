--==============================================================
-- PLAYER HELPERS
--==============================================================

local function resolve(v)

	if not v then
		return
	end

	if typeof(v)=="Instance" then

		if v:IsA("Player") then
			return v
		end

		local x=v

		while x do

			if x:IsA("Model") then

				local p=
					P:GetPlayerFromCharacter(
						x
					)

				if p then
					return p
				end
			end

			x=x.Parent
		end

		return
	end

	local s=low(v)

	for _,p in ipairs(P:GetPlayers()) do

		if s==low(p.Name)
		or s==low(p.DisplayName)
		or s==tostring(p.UserId) then

			return p
		end
	end
end

local function findPlayer(x)

	x=low(clean(x))

	if x=="" then
		return
	end

	for _,p in ipairs(P:GetPlayers()) do

		if p~=L
		and
		(
			low(p.Name)==x
			or
			low(p.DisplayName)==x
		) then

			return p
		end
	end

	for _,p in ipairs(P:GetPlayers()) do

		if p~=L
		and
		(
			low(p.Name):sub(1,#x)==x
			or
			low(p.DisplayName):sub(1,#x)==x
		) then

			return p
		end
	end
end

local function display(user)

	local p=
		P:FindFirstChild(
			tostring(user)
		)

	return
		p
		and p.DisplayName
		or tostring(user)
end

