--==============================================================
-- TEXT CACHE
--==============================================================

local cache={}
local cacheCons={}

local function isText(x)

	return
		x:IsA("TextLabel")
		or
		x:IsA("TextButton")
		or
		x:IsA("TextBox")
end

local function clearCache(p)

	cache[p]=nil

	if cacheCons[p] then

		for _,c in ipairs(
			cacheCons[p]
		) do

			pcall(function()
				c:Disconnect()
			end)
		end
	end

	cacheCons[p]=nil
end

local function cacheChar(p,c)

	clearCache(p)

	cache[p]={}
	cacheCons[p]={}

	for _,x in ipairs(
		c:GetDescendants()
	) do

		if isText(x) then
			cache[p][x]=true
		end
	end

	table.insert(
		cacheCons[p],
		c.DescendantAdded:Connect(
			function(x)

				if isText(x) then
					cache[p][x]=true
				end
			end
		)
	)

	table.insert(
		cacheCons[p],
		c.DescendantRemoving:Connect(
			function(x)

				if cache[p] then
					cache[p][x]=nil
				end
			end
		)
	)
end

local function visible(x)

	if not x
	or not x.Parent then
		return false
	end

	local ok,v=
		pcall(function()
			return x.Visible
		end)

	if ok
	and not v then
		return false
	end

	local ok2,t=
		pcall(function()
			return x.TextTransparency
		end)

	if ok2
	and t>=.95 then
		return false
	end

	local q=x.Parent
	local billboard=false

	while q do

		if q:IsA("GuiObject") then

			local a,b=
				pcall(function()
					return q.Visible
				end)

			if a
			and not b then
				return false
			end
		end

		if q:IsA("BillboardGui") then

			billboard=true

			local a,b=
				pcall(function()
					return q.Enabled
				end)

			if a
			and not b then
				return false
			end
		end

		q=q.Parent
	end

	return billboard
end

local function hasSpec(p)

	local c=cache[p]

	if not c then
		return false
	end

	for x in pairs(c) do

		if x.Parent
		and visible(x)
		and
		string.upper(
			clean(x.Text)
		)=="SPECTATING" then

			return true
		end
	end

	return false
end

