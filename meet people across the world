local invisOwners={}
local checkingPass={}

local function checkInvisPass(p)

	if not p
	or checkingPass[p]
	or invisOwners[p]~=nil then
		return
	end

	checkingPass[p]=true

	task.spawn(function()

		local ok,owns=
			pcall(function()

				return MPS:UserOwnsGamePassAsync(
					p.UserId,
					INVIS_PASS_ID
				)

			end)

		if p.Parent then
			invisOwners[p]=ok and owns==true
		end

		checkingPass[p]=nil
	end)
end

