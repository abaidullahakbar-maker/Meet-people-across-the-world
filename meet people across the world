--==============================================================
-- SPECTATOR HISTORY
--==============================================================

local function formatDuration(seconds)

	seconds=
		math.max(
			0,
			math.floor(
				(seconds or 0)+.5
			)
		)

	if seconds<60 then
		return tostring(seconds).."s"
	end

	if seconds<3600 then

		local m=
			math.floor(
				seconds/60
			)

		local s=seconds%60

		return
			tostring(m)..
			"m "..
			string.format("%02d",s)..
			"s"
	end

	local h=
		math.floor(
			seconds/3600
		)

	local m=
		math.floor(
			(seconds%3600)/60
		)

	return
		tostring(h)..
		"h "..
		string.format("%02d",m)..
		"m"
end

local function specHistoryText(event)

	local duration=
		(
			event.ended
			or os.clock()
		)
		-
		event.started

	local suffix="  • LIVE"

	if event.reason=="stopped" then

		suffix="  • stopped"

	elseif event.reason=="switched" then

		suffix="  • switched"
	end

	return
		event.stamp..
		"  "..
		event.watcher..
		" → "..
		event.target..
		"  • "..
		formatDuration(duration)..
		suffix
end

local function specHistoryColor(event)

	if not event.ended then
		return T.GREEN
	end

	if event.reason=="switched" then
		return T.GOLD
	end

	return T.DIM
end

local function startHistorySession(
	watcher,
	targetPlayer,
	now
)

	local event={
		stamp=os.date("%H:%M:%S"),

		watcher=watcher.DisplayName,

		target=
			targetPlayer
			and targetPlayer.DisplayName
			or "?",

		started=now
	}

	table.insert(specHistory,1,event)

	specSessions[watcher]=event

	while #specHistory>20 do

		local removed=
			table.remove(
				specHistory
			)

		for p,current in pairs(
			specSessions
		) do

			if current==removed then
				specSessions[p]=nil
			end
		end
	end
end

local function finishHistorySession(
	watcher,
	now,
	reason
)

	local event=
		specSessions[
			watcher
		]

	if not event then
		return
	end

	event.ended=now
	event.reason=reason

	specSessions[watcher]=nil
end

local function trackHistory(
	old,
	new,
	now
)

	for watcher,oldData in pairs(old) do

		if watcher~=L then

			local newData=
				new[watcher]

			if not newData then

				finishHistorySession(
					watcher,
					now,
					"stopped"
				)

			elseif
				newData.target
				~=
				oldData.target then

				finishHistorySession(
					watcher,
					now,
					"switched"
				)

				startHistorySession(
					watcher,
					newData.target,
					now
				)
			end
		end
	end

	for watcher,data in pairs(new) do

		if watcher~=L
		and not old[watcher] then

			startHistorySession(
				watcher,
				data.target,
				now
			)
		end
	end
end

--==============================================================
-- SPECTATOR SCAN
--==============================================================

local function sameRelations(a,b)

	for p,d in pairs(a) do

		if not b[p]
		or
		b[p].target~=d.target then

			return false
		end
	end

	for p in pairs(b) do

		if not a[p] then
			return false
		end
	end

	return true
end

local function scan()

	local fresh={}
	local active={}

	local now=os.clock()

	for _,w in ipairs(
		P:GetPlayers()
	) do

		if w~=L then

			local shown=
				w.Character
				and
				hasSpec(w)
				or false

			local inv=
				invisible(w)

			local invisOwner=
				invisOwners[w]==true

			if shown then

				latch[w]=true
				lastSeen[w]=now
			end

			if not shown
			and not inv
			and not invisOwner
			and latch[w] then

				if now-
					(
						lastSeen[w]
						or 0
					)
					>.75 then

					latch[w]=nil
					tc[w]=nil
					RR[w]=nil
				end
			end

			if shown
			or latch[w]
			or inv
			or invisOwner then

				local q=tc[w]

				if not q
				or
				now-q.time>.7 then

					q={
						target=findTarget(w),
						time=now
					}

					tc[w]=q
				end

				if inv
				and q.target then

					latch[w]=true
					lastSeen[w]=now
				end

				if invisOwner
				and q.target then

					latch[w]=true
					lastSeen[w]=now
				end

				local hiddenConfirmed=
					(
						inv
						or invisOwner
					)
					and
					latch[w]
					and
					q.target~=nil

				if shown
				or hiddenConfirmed then

					active[w]=true

					fresh[w]={
						target=q.target
					}
				end

				if invisOwner
				and not shown
				and not q.target
				and latch[w] then

					if now-
						(
							lastSeen[w]
							or 0
						)
						>.85 then

						latch[w]=nil
						tc[w]=nil
						RR[w]=nil
					end
				end
			end
		end
	end

	for w in pairs(tc) do

		if not active[w]
		and not latch[w]
		and not invisOwners[w] then

			tc[w]=nil
		end
	end

	Cam=W.CurrentCamera

	if Cam then

		local t=
			resolve(
				Cam.CameraSubject
			)

		if t
		and t~=L then

			fresh[L]={
				target=t
			}
		end
	end

	local current={}

	for w,d in pairs(fresh) do

		if w~=L
		and d.target==L then

			current[w]=true

			if not watchingMe[w] then
				notifyWatcher(w)
			end
		end
	end

	watchingMe=current

	local changed=
		not sameRelations(
			fresh,
			rel
		)

	if changed then

		trackHistory(
			rel,
			fresh,
			now
		)
	end

	rel=fresh

	if changed then
		markDirty()
	else
		updateMini()
	end
end

