local charAttributeCons={}

local function disconnectCharAttribute(p)

	if charAttributeCons[p] then

		pcall(function()
			charAttributeCons[p]:Disconnect()
		end)

		charAttributeCons[p]=nil
	end
end

local function hookInvisibleAttribute(p,c)

	disconnectCharAttribute(p)

	charAttributeCons[p]=
		c:GetAttributeChangedSignal(
			"Invisible"
		):Connect(
			function()

				if not alive then
					return
				end

				if seeInvisible then

					pcall(
						updateInvisibleESP
					)

				else

					removeInvisibleESP(p)
				end
			end
		)
end

local function setup(p)

	checkInvisPass(p)

	lastRoom[p]=
		p:GetAttribute(
			"RoomTP"
		)

	connect(
		p:GetAttributeChangedSignal(
			"RoomTP"
		),
		function()
			roomChanged(p)
		end
	)

	if p.Character then

		cacheChar(
			p,
			p.Character
		)

		hookInvisibleAttribute(
			p,
			p.Character
		)
	end

	connect(
		p.CharacterAdded,
		function(c)

			removeInvisibleESP(p)

			task.wait(.35)

			cacheChar(
				p,
				c
			)

			hookInvisibleAttribute(
				p,
				c
			)

			tc[p]=nil

			if seeInvisible then

				pcall(
					updateInvisibleESP
				)
			end

			if p==target
			and spectating then

				local h=
					c:WaitForChild(
						"Humanoid",
						10
					)

				if h then

					Cam=W.CurrentCamera
					Cam.CameraSubject=h
				end
			end
		end
	)
end

for _,p in ipairs(
	P:GetPlayers()
) do
	setup(p)
end

connect(
	P.PlayerAdded,
	function(p)

		setup(p)

		rebuildGroups()
		markDirty()
	end
)

connect(
	P.PlayerRemoving,
	function(p)

		if lastRoom[p] then

			addHistory(
				p.DisplayName..
					" left "..
					display(
						lastRoom[p]
					)
			)
		end

		if specSessions[p] then

			finishHistorySession(
				p,
				os.clock(),
				"stopped"
			)
		end

		clearCache(p)

		disconnectCharAttribute(p)
		removeInvisibleESP(p)

		latch[p]=nil
		lastSeen[p]=nil

		RR[p]=nil
		tc[p]=nil

		invisOwners[p]=nil
		checkingPass[p]=nil

		watchingMe[p]=nil
		lastRoom[p]=nil

		rebuildGroups()
		markDirty()

		if p==target then
			stopSpec()
		end
	end
)

