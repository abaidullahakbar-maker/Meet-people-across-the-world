		if not myRoot
		or not theirRoot then
			return
		end

		pcall(function()

			myChar:PivotTo(
				theirRoot.CFrame
				*
				CFrame.new(
					0,
					0,
					2.5
				)
			)
		end)
	end
)


--==============================================================
-- GAME SPECTATE MENU • FREE NUKE TP BUTTON (LOW-LAG)
--==============================================================

local gameSpectateTP=nil
local gameSpectateSource=nil
local gameSpectateRoot=nil
local spectateSearchQueued=false
local lastSpectateSearch=0

local function textOf(x)
	local ok,value=pcall(function()
		return x.Text
	end)

	return ok and clean(value) or ""
end

local function isTextObject(x)
	return x:IsA("TextLabel")
		or x:IsA("TextButton")
		or x:IsA("TextBox")
end

-- Only walks a candidate branch when we already found something relevant.
local function branchHasText(root,needle)
	if not root or not root.Parent then
		return false
	end

	needle=low(needle)

	if isTextObject(root)
	and low(textOf(root)):find(needle,1,true) then
		return true
	end

	for _,x in ipairs(root:GetDescendants()) do
		if isTextObject(x)
		and low(textOf(x)):find(needle,1,true) then
			return true
		end
	end

	return false
end

local function findSpectateRootFrom(source)
	local x=source and source.Parent
	local depth=0

	-- Spectate panel is normally only a few ancestors above the button.
	while x and x~=PG and depth<8 do
		if branchHasText(x,"stop spectating") then
			return x
		end

		x=x.Parent
		depth+=1
	end

	return source and source.Parent or nil
end

local function candidateTeleportButton(x)
	if not x
	or not x.Parent
	or not x:IsA("TextButton")
	or x.Name=="NUKE_SpectateTP"
	or x:IsDescendantOf(G) then
		return false
	end

	return low(textOf(x)):find("teleport",1,true)~=nil
end

local function setSpectateSource(source)
	if not candidateTeleportButton(source) then
		return false
	end

	local root=findSpectateRootFrom(source)

	if not root
	or not branchHasText(root,"stop spectating") then
		return false
	end

	gameSpectateSource=source
	gameSpectateRoot=root
	return true
end

local function findGameSpectateTeleport()
	-- Reuse cached objects first: zero full PlayerGui scan in normal use.
	if gameSpectateSource
	and gameSpectateSource.Parent
	and gameSpectateRoot
	and gameSpectateRoot.Parent then
		return gameSpectateSource,gameSpectateRoot
	end

	-- Search TextButtons only when cache is missing.
	for _,x in ipairs(PG:GetDescendants()) do
		if candidateTeleportButton(x)
		and setSpectateSource(x) then
			return gameSpectateSource,gameSpectateRoot
		end
	end
end

local function selectedSpectatePlayer(root)
	if not root or not root.Parent then
		return nil
	end

	-- Usually the title contains @Username. This avoids looping every player
	-- for every UI label unless the username form is unavailable.
	local textObjects={}

	for _,x in ipairs(root:GetDescendants()) do
		if x:IsA("TextLabel")
		or x:IsA("TextButton") then
			textObjects[#textObjects+1]=x

			local username=textOf(x):match("@([%w_]+)")
			if username then
				local p=P:FindFirstChild(username)
				if p and p~=L then
					return p
				end
			end
		end
	end

	-- Rare fallback for interfaces that only display Name / DisplayName.
	for _,x in ipairs(textObjects) do
		local value=low(textOf(x))

		for _,p in ipairs(P:GetPlayers()) do
			if p~=L
			and
			(
				value==low(p.Name)
				or value==low(p.DisplayName)
			) then
				return p
			end
		end
	end
end

local function teleportToPlayer(p)
	if not p or p==L or not p.Parent then
		return false
	end

	local myChar=L.Character
	local theirChar=p.Character

	if not myChar or not theirChar then
		return false
	end

	local myRoot=myChar:FindFirstChild("HumanoidRootPart")
	local theirRoot=theirChar:FindFirstChild("HumanoidRootPart")

	if not myRoot or not theirRoot then
		return false
	end

	return pcall(function()
		myChar:PivotTo(
			theirRoot.CFrame*CFrame.new(0,0,2.5)
		)
	end)
end

local function removeGameSpectateTP()
	if gameSpectateTP then
		pcall(function()
			gameSpectateTP:Destroy()
		end)
	end

	gameSpectateTP=nil
end

local function clearGameSpectateCache()
	removeGameSpectateTP()
	gameSpectateSource=nil
	gameSpectateRoot=nil
end

