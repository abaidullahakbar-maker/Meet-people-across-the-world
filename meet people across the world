	a.TextColor3=T.GREEN

	a.TextStrokeTransparency=.2
	a.TextStrokeColor3=Color3.new()

	a.Font=Enum.Font.GothamBold
	a.TextSize=11

	local b=Instance.new("TextLabel",g)

	b.Name="WatchedBy"

	b.Size=
		UDim2.new(
			1,
			0,
			.5,
			0
		)

	b.Position=
		UDim2.new(
			0,
			0,
			.5,
			0
		)

	b.BackgroundTransparency=1
	b.TextColor3=T.RED

	b.TextStrokeTransparency=.2
	b.TextStrokeColor3=Color3.new()

	b.Font=Enum.Font.GothamBold
	b.TextSize=11

	OH[p]=g

	return g
end

local function updateOH()

	if not overhead then

		clearOH()
		return
	end

	local watching={}
	local watched={}
	local needed={}

	for w,d in pairs(rel) do

		local t=d.target

		if t
		and w.Parent
		and t.Parent then

			watching[w]=t
			watched[t]=watched[t] or {}

			table.insert(
				watched[t],
				w
			)
		end
	end

	for w,t in pairs(watching) do

		needed[w]=true

		local g=getOH(w)

		if g then

			g.Watching.Text=
				"▲ Watching: "..
				t.DisplayName
		end
	end

	for t,ws in pairs(watched) do

		needed[t]=true

		local names={}

		for _,w in ipairs(ws) do
			table.insert(names,w.DisplayName)
		end

		table.sort(names)

		local g=getOH(t)

		if g then

			g.WatchedBy.Text=
				"▲ Watched by: "..
				table.concat(
					names,
					", "
				)
		end
	end

	for p,g in pairs(OH) do

		if not needed[p] then

			delOH(p)

		else

			if not watching[p] then
				g.Watching.Text=""
			end

			if not watched[p] then
				g.WatchedBy.Text=""
			end
		end
	end
end

