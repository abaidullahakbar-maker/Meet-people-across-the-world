	end

	alive=false

	for _,c in ipairs(CON) do

		pcall(function()
			c:Disconnect()
		end)
	end

	for p in pairs(cacheCons) do
		clearCache(p)
	end

	for p in pairs(charAttributeCons) do
		disconnectCharAttribute(p)
	end

	clearOH()
	clearDoorESP()
	clearInvisibleESP()
	clearGameSpectateCache()

	pcall(function()
		AlertSound:Destroy()
	end)

	pcall(function()
		G:Destroy()
	end)
end

