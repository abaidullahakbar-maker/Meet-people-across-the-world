local function validField(n)

	n=low(n)

	for _,bad in ipairs({
		"troll",
		"grab",
		"favorite",
		"friend",
		"booth",
		"copy",
		"owner",
		"room",
		"call",
		"borrow",
		"camerafov"
	}) do

		if n:find(
			bad,
			1,
			true
		) then

			return false
		end
	end

	return
		n:find(
			"spectat",
			1,
			true
		)
		or
		n:find(
			"watching",
			1,
			true
		)
		or
		n:find(
			"watchtarget",
			1,
			true
		)
		or
		n:find(
			"observ",
			1,
			true
		)
end

local RV={}
local RR={}
local HR={}

local latch={}
local lastSeen={}
local tc={}

local function addCandidate(
	c,
	w,
	t,
	score
)

	if not t
	or t==w then
		return
	end

	if not c[t]
	or score>c[t] then

		c[t]=score
	end
end

local function registerValue(x)

	if not x:IsA(
		"ValueBase"
	) then
		return
	end

	local n=x.Name

	pcall(function()
		n=x:GetFullName()
	end)

	if validField(n) then
		RV[x]=true
	end
end

for _,x in ipairs(
	R:GetDescendants()
) do
	registerValue(x)
end

connect(
	R.DescendantAdded,
	registerValue
)

connect(
	R.DescendantRemoving,
	function(x)
		RV[x]=nil
	end
)

local function inspect(
	root,
	w,
	c
)

	if not root then
		return
	end

	local function attrs(x)

		local ok,a=
			pcall(function()
				return x:GetAttributes()
			end)

		if not ok then
			return
		end

		for n,v in pairs(a) do

			if validField(n) then

				addCandidate(
					c,
					w,
					resolve(v),
					400
				)
			end
		end
	end

	attrs(root)

	for _,x in ipairs(
		root:GetDescendants()
	) do

		if validField(x.Name) then
			attrs(x)
		end

		if x:IsA(
			"ValueBase"
		) then

			local n=x.Name

			pcall(function()
				n=x:GetFullName()
			end)

			if validField(n) then

				local ok,v=
					pcall(function()
						return x.Value
					end)

				if ok then

					addCandidate(
						c,
						w,
						resolve(v),
						420
					)
				end
			end
		end
	end
end

local function findTarget(w)

	local c={}

	inspect(w,w,c)

	if w.Character then
		inspect(w.Character,w,c)
	end

	for x in pairs(RV) do

		if x.Parent then

			local path=
				low(
					x:GetFullName()
				)

			if path:find(
				low(w.Name),
				1,
				true
			)
			or
			path:find(
				tostring(
					w.UserId
				),
				1,
				true
			) then

				local ok,v=
					pcall(function()
						return x.Value
					end)

				if ok then

					addCandidate(
						c,
						w,
						resolve(v),
						450
					)
				end
			end
		end
	end

	local rr=RR[w]

	if rr
	and os.clock()-rr.time<5 then

		addCandidate(
			c,
			w,
			rr.target,
			600
		)
	end

	local best=nil
	local score=0

	for p,s in pairs(c) do

		if s>score then

			best=p
			score=s
		end
	end

	return
		score>=400
		and best
		or nil
end

--==============================================================
-- SPECTATE REMOTES
--==============================================================

local function collect(
	v,
	out,
	d
)

	d=d or 0

	if d>2 then
		return
	end

	local p=resolve(v)

	if p then

		out[p]=true
		return
	end

	if type(v)=="table" then

		local n=0

		for _,z in pairs(v) do

			n+=1

			if n>20 then
				break
			end

			collect(
				z,
				out,
				d+1
			)
		end
	end
end

local function hookRemote(r)

	if HR[r]
	or
	not r:IsA(
		"RemoteEvent"
	) then

		return
	end

	local name=low(r.Name)

	if not name:find(
		"spectat",
		1,
		true
	) then
		return
	end

	HR[r]=true

	connect(
		r.OnClientEvent,
		function(...)

			local found={}

			for _,v in ipairs({...}) do

				collect(
					v,
					found,
					0
				)
			end

			local list={}

			for p in pairs(found) do
				table.insert(list,p)
			end

			local stop=
				name:find(
					"stop",
					1,
					true
				)
				or
				name:find(
					"cancel",
					1,
					true
				)
				or
				name:find(
					"reset",
					1,
					true
				)

			if stop then

				for _,p in ipairs(list) do

					latch[p]=nil
					tc[p]=nil
					RR[p]=nil
				end

				return
			end

			if #list<2 then
				return
			end

			local watcher=nil

			for _,p in ipairs(list) do

				if hasSpec(p) then

					watcher=p
					break
				end
			end

			if not watcher then

				local inv={}

				for _,p in ipairs(list) do

					if invisible(p) then
						table.insert(inv,p)
					end
				end

				if #inv==1 then
					watcher=inv[1]
				end
			end

			if watcher then

				for _,t in ipairs(list) do

					if t~=watcher then

						RR[watcher]={
							target=t,
							time=os.clock()
						}

						latch[watcher]=true
						lastSeen[watcher]=os.clock()

						break
					end
				end
			end
		end
	)
end

for _,x in ipairs(
	R:GetDescendants()
) do
	hookRemote(x)
end

connect(
	R.DescendantAdded,
	hookRemote
)

