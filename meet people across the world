updateMini=function()

	local specCount=0
	local rows={}

	for watcher,data in pairs(rel) do

		specCount+=1

		local targetName=
			data
			and data.target
			and data.target.DisplayName
			or "?"

		table.insert(
			rows,
			watcher.DisplayName..
				"  →  "..
				targetName
		)
	end

	table.sort(rows)

	local occupied=0

	for _,room in ipairs(rooms) do

		if #(
			groups[
				room.user
			]
			or {}
		)>0 then

			occupied+=1
		end
	end

	MiniStats.Text=
		"SPEC "..
			specCount..
			"  •  ROOMS "..
			occupied

	MiniStats.TextColor3=
		specCount>0
		and T.GREEN
		or T.SUB

	if #rows==0 then

		MiniNames.Text="No spectators"
		MiniNames.TextColor3=T.DIM

	else

		local shown={}

		for i=1,
			math.min(
				#rows,
				2
			) do

			table.insert(
				shown,
				rows[i]
			)
		end

		local extra=
			#rows-#shown

		MiniNames.Text=
			table.concat(
				shown,
				"   •   "
			)
			..
			(
				extra>0
				and "   +"..extra
				or ""
			)

		MiniNames.TextColor3=T.TEXT
	end
end

local function setMini(value)

	miniMode=value
	OP.Visible=false

	if miniMode then

		M.Visible=false
		Mini.Visible=true

	else

		Mini.Visible=false
		M.Visible=true
	end

	updateMini()
end

connect(
	Minimize.MouseButton1Click,
	function()
		setMini(true)
	end
)

